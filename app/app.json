{
  "expo": {
    "name": "Mova",
    "slug": "mova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mova",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mova використовує мікрофон для голосових розмов з репетитором."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mova"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-audio"
    ],
    "scheme": "mova",
    "backgroundColor": "#0E1014",
    "experiments": {
      "typedRoutes": true
    }
  }
}
